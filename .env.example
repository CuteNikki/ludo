# Copy to `.env` (git-ignored) in the repo root, next to docker-compose.yml. Read by Docker Compose (as build
# args for the web image) and by `next dev` / `next build` (restart the dev server after editing).
# Operator details shown on the /imprint page. Required for a public deployment; without them the
# page shows a "not configured" notice instead.
LEGAL_NAME=
# Address lines separated by ";", e.g. Example Street 1; 12345 Example City; Germany
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Optional
LEGAL_PHONE=
